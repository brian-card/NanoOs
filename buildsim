#!/bin/bash

set -e

hostname="${1}"
blockFilesystem="${2}"
filesystem="fat32"
imageSizeMB=100
partitionOffsetMB=2
blocksPerOverlay=16

if [ "${hostname}" = "" ] || [ "${blockFilesystem}" = "" ]; then
	echo "Usage: ${0} <hostname> <blockFilesystem> [command to run before sim]" >&2
	exit 1
fi

if [ ! -f "usr/src/filesystems/${blockFilesystem}/makefile" ]; then
	echo "ERROR: No block filesystem found at usr/src/filesystems/${blockFilesystem}." >&2
	exit 1
fi

shift 2

imageFile="$(mktemp)"

cleanup() {
	rm -f "${imageFile}"
	stty echo
}
trap cleanup ERR EXIT

dd if=/dev/zero of="${imageFile}" bs=1M count=${imageSizeMB} status=progress

if [ "${blockFilesystem}" = "contiguous" ]; then
	filesystemLinkerScript="NanoOsSimContiguous.ld"
else
	filesystemLinkerScript="NanoOsSim.ld"
fi

echo "Building applications..."
make -j $(nproc) -C usr/src clean
make -j $(nproc) -C usr/src/filesystems/${blockFilesystem} clean
make -j $(nproc) -C usr/src COMPILE=gcc LINK=ld OBJCOPY=objcopy \
	OBJDUMP=objdump SIZE=size LINKER_SCRIPT=NanoOsSim.ld overlays
make -j $(nproc) -C usr/src/filesystems/${blockFilesystem} COMPILE=gcc LINK=ld OBJCOPY=objcopy \
	OBJDUMP=objdump SIZE=size LINKER_SCRIPT=${filesystemLinkerScript} \
	FILESYSTEM="${filesystem}" overlays
make -j $(nproc) -C sim clean
make -j $(nproc) -C sim

echo ""
echo "Build complete."

# Partition: MBR, FAT32 (partition type 0xc) starting at 2 MiB.
# sfdisk is used instead of parted because parted truncates image files
# to the minimum size needed for the partition table, discarding the
# pre-allocated space from dd.
echo "${partitionOffsetMB}MiB,+,c" | sfdisk "${imageFile}"

# Partition offset in bytes, which mtools' "@@offset" syntax needs to
# address the FAT32 partition directly. The byte offset is computed
# explicitly (rather than using @@2M) to avoid mtools interpreting 'M' as
# SI megabytes (1,000,000) instead of binary mebibytes (1,048,576), which
# would misalign reads/writes vs. sfdisk.
partitionOffsetBytes=$(( partitionOffsetMB * 1024 * 1024 ))

# Format and populate the FAT32 partition at the 2 MiB offset. Cluster size
# and total sector count are intentionally left for mformat to auto-detect
# from the remaining file size at the offset: forcing a cluster size here
# (e.g. reusing blocksPerOverlay) can produce fewer than the ~65525
# clusters required for a partition this size to be recognized as genuine
# FAT32, which strict FAT32 readers such as fab-agon-emulator reject.
fatImage="${imageFile}@@${partitionOffsetBytes}"

MTOOLS_SKIP_CHECK=1 mformat -i "${fatImage}" -F -v NanoOs ::
MTOOLS_SKIP_CHECK=1 mmd -i "${fatImage}" ::/usr
MTOOLS_SKIP_CHECK=1 mcopy -i "${fatImage}" -s usr/bin ::/usr/bin
MTOOLS_SKIP_CHECK=1 mcopy -i "${fatImage}" -s usr/lib ::/usr/lib
MTOOLS_SKIP_CHECK=1 mmd -i "${fatImage}" ::/etc
printf '%s' "${hostname}" \
	| MTOOLS_SKIP_CHECK=1 mcopy -i "${fatImage}" - ::/etc/hostname
printf '\\s \\r \\n \\l\n\n' \
	| MTOOLS_SKIP_CHECK=1 mcopy -i "${fatImage}" - ::/etc/issue

# Write block overlays into the image at their absolute sector positions,
# relative to the start of the image. Overlay IDs start at 1 to avoid
# colliding with the MBR at sector 0.
if [ "${blockFilesystem}" = "contiguous" ]; then
	# The contiguous filesystem is a single overlay occupying the same
	# starting position slot 0 would under the per-slot scheme; it has no
	# fixed per-slot block budget, so its build (see makefile) fails
	# instead if it grows past what fits before the FAT32 partition.
	dd if="usr/filesystem/contiguous/0.overlay" of="${imageFile}" bs=512 \
		seek=1 conv=notrunc
else
	blockOverlays="$(ls usr/filesystem/${blockFilesystem}/*)"
	for blockOverlay in ${blockOverlays}; do
		overlayId="$(basename "${blockOverlay}" .overlay)"
		startBlock=$(( (overlayId * blocksPerOverlay) + 1 ))
		dd if="${blockOverlay}" of="${imageFile}" bs=512 seek=${startBlock} \
			conv=notrunc
	done
fi

${@} sim/bin/nano-os-sim "${imageFile}"
