#!/bin/bash

set -e

platform="${1}"
hostname="${2}"
targetDevice="${3}"
blockFilesystem="${4}"
rootFilesystemSource="${5}"
filesystem="fat32"
blocksPerOverlay=8

if [ "${platform}" = "" ] || [ "${hostname}" = "" ] \
		|| [ "${targetDevice}" = "" ] || [ "${blockFilesystem}" = "" ]; then
	echo "Usage: ${0} <AgonLight2|itsybitsy_m0|feather_m0_wifi|trinket_m0|nano_33_iot|xiao_m0> <hostname> <target device or image file> <blockFilesystem> [rootFilesystemSource]" >&2
	exit 1
fi

if [ -n "${rootFilesystemSource}" ] && [ ! -d "${rootFilesystemSource}" ]; then
	echo "ERROR: No root filesystem source directory found at ${rootFilesystemSource}." >&2
	exit 1
fi

if [ ! -f "usr/src/filesystems/${blockFilesystem}/makefile" ]; then
	echo "ERROR: No block filesystem found at usr/src/filesystems/${blockFilesystem}." >&2
	exit 1
fi

if [ "${platform}" = "itsybitsy_m0" ] || [ "${platform}" = "feather_m0_wifi" ] \
		|| [ "${platform}" = "trinket_m0" ] \
		|| [ "${platform}" = "nano_33_iot" ] \
		|| [ "${platform}" = "xiao_m0" ]; then
	compile="arm-none-eabi-gcc"
	link="arm-none-eabi-ld"
	objcopy="arm-none-eabi-objcopy"
	objdump="arm-none-eabi-objdump"
	size="arm-none-eabi-size"
	linkerScript="NanoOsArduinoSamd21.ld"
	extraIncludes=""
	extraLinks=""
	osMakefile="makefiles/ArduinoSamd21Makefile"
	osBuildDir="build/${platform}"
	osMakeArgs="BOARD=${platform}"
elif [ "${platform}" = "AgonLight2" ]; then
	agonHome="${HOME}/agondev"
	agonDevBin="${agonHome}/bin"
	compile="${agonDevBin}/ez80-none-elf-clang"
	link="${agonDevBin}/ez80-none-elf-ld"
	objcopy="${agonDevBin}/ez80-none-elf-objcopy"
	objdump="${agonDevBin}/ez80-none-elf-objdump"
	size="${agonDevBin}/ez80-none-elf-size"
	linkerScript="NanoOsAgonLight2.ld"
	clangResourceDir="$("${compile}" --print-resource-dir 2>/dev/null)"
	extraIncludes="-isystem ${agonHome}/include"
	if [ -n "${clangResourceDir}" ]; then
		extraIncludes="${extraIncludes} -isystem ${clangResourceDir}/include"
	fi
	extraIncludes="${extraIncludes} -I$(pwd)/src/include/ez80-none-elf-clang"
	libcSrc="$(pwd)/src/kernel/libc/ez80-none-elf-clang/stdatomic.c"
	libcObjDir="$(pwd)/usr/obj/AgonLight2/libc"
	extraLinks="--start-group -L${agonHome}/lib -lagon ${libcObjDir}/stdatomic.o --end-group"
	osMakefile="makefiles/AgonLight2Makefile"
	osBuildDir="build/agon"
	osMakeArgs=""
else
	echo "ERROR: Unknown platform '${platform}'." >&2
	echo "Must be 'AgonLight2' or one of the ArduinoSamd21Makefile boards:" >&2
	echo "  itsybitsy_m0, feather_m0_wifi, trinket_m0, nano_33_iot, xiao_m0" >&2
	exit 1
fi

osFullBin="${osBuildDir}/NanoOs_full.bin"
osRodataBin="${osBuildDir}/NanoOs_rodata.bin"

filesystemLinkerScript="${linkerScript}"
if [ "${blockFilesystem}" = "contiguous" ]; then
	filesystemLinkerScript="${linkerScript%.ld}Contiguous.ld"
	if [ ! -f "usr/src/${filesystemLinkerScript}" ]; then
		echo "ERROR: No contiguous-filesystem linker script found at usr/src/${filesystemLinkerScript}." >&2
		echo "The per-slot ${linkerScript} OVERLAY_RAM region is sized for a single" >&2
		echo "small overlay, not the combined contiguous filesystem binary (up to 32KB)." >&2
		echo "A ${platform}-specific contiguous linker script with a region sized for" >&2
		echo "that platform's actual available RAM needs to be created before building" >&2
		echo "the contiguous filesystem for this target." >&2
		exit 1
	fi
fi

if [ -n "${libcSrc:-}" ]; then
	echo "Building kernel libc..."
	mkdir -p "${libcObjDir}"
	"${compile}" -std=gnu17 --target=ez80-none-elf \
		-mllvm -z80-gas-style \
		-mllvm -z80-print-zero-offset \
		-Wa,-march=ez80+full \
		-Os -nostdlib -ffreestanding \
		-fno-pic -fno-pie -static \
		-ffunction-sections -fdata-sections -fcf-protection=none \
		-fno-jump-tables \
		-fno-stack-protector \
		-DNANO_OS_AGON_LIGHT_2 \
		-Wall -Wextra -pedantic -Werror \
		${extraIncludes} -I"$(pwd)/src/kernel" \
		-c "${libcSrc}" -o "${libcObjDir}/stdatomic.o"
fi

echo "Building OS image..."
make -j $(nproc) -f "${osMakefile}" ${osMakeArgs} clean
make -j $(nproc) -f "${osMakefile}" ${osMakeArgs}

echo "Building applications..."
make -j $(nproc) -C usr/src clean
make -j $(nproc) -C usr/src/filesystems/${blockFilesystem} clean
make -j $(nproc) -C usr/src COMPILE="${compile}" LINK="${link}" \
	OBJCOPY="${objcopy}" OBJDUMP="${objdump}" \
	SIZE="${size}" LINKER_SCRIPT="${linkerScript}" \
	EXTRA_INCLUDES="${extraIncludes}" EXTRA_LINKS="${extraLinks}" overlays
make -j $(nproc) -C usr/src/filesystems/${blockFilesystem} COMPILE="${compile}" LINK="${link}" \
	OBJCOPY="${objcopy}" OBJDUMP="${objdump}" \
	SIZE="${size}" LINKER_SCRIPT="${filesystemLinkerScript}" \
	EXTRA_INCLUDES="${extraIncludes}" EXTRA_LINKS="${extraLinks}" \
	FILESYSTEM="${filesystem}" overlays

echo ""
echo "Build complete."

if [ -b "${targetDevice}" ]; then
	# Make a temporary mountpoint
	mountDir="$(mktemp -d)"
	trap "rm -rf \"${mountDir}\"" ERR EXIT

	echo '2048,,0c' | sudo sfdisk "${targetDevice}"
	sudo mkfs.vfat -F 32 "${targetDevice}p1" -n NanoOs
	sudo mount "${targetDevice}p1" "${mountDir}"

	if [ -n "${rootFilesystemSource}" ]; then
		sudo cp -r "${rootFilesystemSource}/." "${mountDir}"
	fi

	sudo mkdir -p "${mountDir}/usr"
	sudo cp -r usr/bin "${mountDir}/usr"
	sudo cp -r usr/lib "${mountDir}/usr"
	sudo cp "${osRodataBin}" "${mountDir}/usr/lib"
	sudo mkdir -p "${mountDir}/bin"
	sudo cp "${osFullBin}" "${mountDir}/bin"
	sudo mkdir -p "${mountDir}/etc"
	sudo bash -c "printf \"${hostname}\" >\"${mountDir}/etc/hostname\""
	sudo bash -c "printf '\\s \\\r \\\n \\l\n\n' >\"${mountDir}/etc/issue\""
	sudo umount "${mountDir}"

	if [ "${blockFilesystem}" = "contiguous" ]; then
		# The contiguous filesystem is a single overlay occupying the same
		# starting position slot 0 would under the per-slot scheme; it has no
		# fixed per-slot block budget, so its build (see makefile) fails
		# instead if it grows past what fits before the FAT32 partition.
		sudo dd if="usr/filesystem/contiguous/0.overlay" of="${targetDevice}" \
			bs=512 seek=1
	else
		blockOverlays="$(ls usr/filesystem/${blockFilesystem}/*)"
		for blockOverlay in ${blockOverlays}; do
			overlayId="$(basename "${blockOverlay}" .overlay)"
			startBlock=$(( (overlayId * blocksPerOverlay) + 1 ))
			sudo dd if="${blockOverlay}" of="${targetDevice}" bs=512 \
				seek=${startBlock}
		done
	fi
else
	# targetDevice is a path to a disk image file rather than a real block
	# device; build it with the same size and layout as the buildsim script.
	imageSizeMB=100
	partitionOffsetMB=2
	imageBlocksPerOverlay=16

	dd if=/dev/zero of="${targetDevice}" bs=1M count=${imageSizeMB} \
		status=progress

	# Partition: MBR, FAT32 (partition type 0xc) starting at 2 MiB.
	# sfdisk is used instead of parted because parted truncates image files
	# to the minimum size needed for the partition table, discarding the
	# pre-allocated space from dd.
	echo "${partitionOffsetMB}MiB,+,c" | sfdisk "${targetDevice}"

	# Partition offset in bytes, which mtools' "@@offset" syntax needs to
	# address the FAT32 partition directly. The byte offset is computed
	# explicitly (rather than using @@2M) to avoid mtools interpreting 'M'
	# as SI megabytes (1,000,000) instead of binary mebibytes (1,048,576),
	# which would misalign reads/writes vs. sfdisk.
	partitionOffsetBytes=$(( partitionOffsetMB * 1024 * 1024 ))

	# Format and populate the FAT32 partition at the 2 MiB offset. Cluster
	# size and total sector count are intentionally left for mformat to
	# auto-detect from the remaining file size at the offset: forcing a
	# cluster size here (e.g. reusing imageBlocksPerOverlay) can produce
	# fewer than the ~65525 clusters required for a partition this size to
	# be recognized as genuine FAT32, which strict FAT32 readers such as
	# fab-agon-emulator reject.
	fatImage="${targetDevice}@@${partitionOffsetBytes}"

	MTOOLS_SKIP_CHECK=1 mformat -i "${fatImage}" -F -v NanoOs ::

	if [ -n "${rootFilesystemSource}" ]; then
		shopt -s dotglob nullglob
		for rootFilesystemEntry in "${rootFilesystemSource}"/*; do
			MTOOLS_SKIP_CHECK=1 mcopy -i "${fatImage}" -s \
				"${rootFilesystemEntry}" ::
		done
		shopt -u dotglob nullglob
	fi

	MTOOLS_SKIP_CHECK=1 mdir -i "${fatImage}" ::/usr >/dev/null 2>&1 \
		|| MTOOLS_SKIP_CHECK=1 mmd -i "${fatImage}" ::/usr
	MTOOLS_SKIP_CHECK=1 mcopy -i "${fatImage}" -s usr/bin ::/usr/bin
	MTOOLS_SKIP_CHECK=1 mcopy -i "${fatImage}" -s usr/lib ::/usr/lib
	MTOOLS_SKIP_CHECK=1 mcopy -i "${fatImage}" "${osRodataBin}" ::/usr/lib/
	MTOOLS_SKIP_CHECK=1 mdir -i "${fatImage}" ::/bin >/dev/null 2>&1 \
		|| MTOOLS_SKIP_CHECK=1 mmd -i "${fatImage}" ::/bin
	MTOOLS_SKIP_CHECK=1 mcopy -i "${fatImage}" "${osFullBin}" ::/bin/
	MTOOLS_SKIP_CHECK=1 mdir -i "${fatImage}" ::/etc >/dev/null 2>&1 \
		|| MTOOLS_SKIP_CHECK=1 mmd -i "${fatImage}" ::/etc
	printf '%s' "${hostname}" \
		| MTOOLS_SKIP_CHECK=1 mcopy -i "${fatImage}" - ::/etc/hostname
	printf '\\s \\r \\n \\l\n\n' \
		| MTOOLS_SKIP_CHECK=1 mcopy -i "${fatImage}" - ::/etc/issue

	# Write block overlays into the image at their absolute sector positions,
	# relative to the start of the image. Overlay IDs start at 1 to avoid
	# colliding with the MBR at sector 0.
	if [ "${blockFilesystem}" = "contiguous" ]; then
		# The contiguous filesystem is a single overlay occupying the same
		# starting position slot 0 would under the per-slot scheme; it has no
		# fixed per-slot block budget, so its build (see makefile) fails
		# instead if it grows past what fits before the FAT32 partition.
		dd if="usr/filesystem/contiguous/0.overlay" of="${targetDevice}" \
			bs=512 seek=1 conv=notrunc
	else
		blockOverlays="$(ls usr/filesystem/${blockFilesystem}/*)"
		for blockOverlay in ${blockOverlays}; do
			overlayId="$(basename "${blockOverlay}" .overlay)"
			startBlock=$(( (overlayId * imageBlocksPerOverlay) + 1 ))
			dd if="${blockOverlay}" of="${targetDevice}" bs=512 \
				seek=${startBlock} conv=notrunc
		done
	fi
fi
